# Jev AI (decision API). Without a key the heuristic engine is used.
JEV_API_KEY=
JEV_API_BASE_URL=https://thejevai.com
JEV_MODEL=typesafe/jev-1.13
JEV_MAX_CREDITS_PER_RUN=500
JEV_CONCURRENCY=4

# InfoJobs official API (https://developer.infojobs.net)
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=

# Optional comma-separated proxy list (http://user:pass@host:port)
PROXIES=

# Free local engine (Laya). Start it with scripts/laya.ps1
LAYA_BASE_URL=http://127.0.0.1:8000
LAYA_MODEL=multilingual
LAYA_MAX_LEN=4096
LAYA_API_KEY=
